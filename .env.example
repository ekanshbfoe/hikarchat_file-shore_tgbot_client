# Required
BOT_TOKEN=
OWNER_ID=
# Private channel that holds every stored file and backup. Starts with -100.
BACKUP_CHANNEL_ID=
# Neon or Supabase connection string. Any postgres:// style URL is accepted.
DATABASE_URL=

# Optional
# Direct (non-pooled) connection used only for migrations.
DATABASE_DIRECT_URL=
# Comma separated, with or without @.
MODERATOR_USERNAMES=
# Group where the client sees activity and reviews let-through users. Starts with -100.
# Must be a different chat from BACKUP_CHANNEL_ID, with the bot added as a member.
LOG_CHAT_ID=
# Telegram chat that receives technical failure details. Never give this to the client.
DEV_CHAT_ID=
# Set automatically on Render through RENDER_EXTERNAL_URL.
WEBHOOK_BASE_URL=
# Failed screenshots allowed before someone is let through anyway. 0 = keep asking.
SCREENSHOT_MAX_ATTEMPTS=3
# Only for a self-hosted Telegram Bot API server. Leave empty normally.
TELEGRAM_API_URL=
# webhook on Render, polling for local development only.
RUN_MODE=webhook
